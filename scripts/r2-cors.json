{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://subsurfaces.net",
          "https://www.subsurfaces.net",
          "https://wiki.subsurfaces.net",
          "https://chat.subsurfaces.net",
          "http://localhost:5173",
          "http://localhost:5174"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Content-Type", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
